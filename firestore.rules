rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isRoomParticipant(roomId) {
      // Use user document's roomId for faster, more reliable checks
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roomId == roomId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    // Pairings/Invites
    match /invites/{code} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // Rooms & Subcollections
    match /rooms/{roomId} {
      allow read, update: if isRoomParticipant(roomId);
      allow create: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if isRoomParticipant(roomId);
      }
    }

    // Shared Vault per Room
    match /vault/{itemId} {
      allow read: if isSignedIn() && isRoomParticipant(resource.data.roomId);
      allow create: if isSignedIn() && isRoomParticipant(request.resource.data.roomId);
      allow update, delete: if isSignedIn() && isRoomParticipant(resource.data.roomId);
    }
  }
}
